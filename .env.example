# Copiá este archivo a .env.local y completá los valores.
# En Vercel se cargan en Settings > Environment Variables (Production y Preview).
# El paso a paso de cada una está en CREDENCIALES.md.
# Ninguna función rompe la app si le falta su clave: /configurar muestra qué falta.

# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública ("publishable" o "anon"). Es la única que llega al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave de servicio ("secret" o "service_role"). Solo servidor. Nunca con NEXT_PUBLIC_.
# La usan el programador de llamadas, el contador de voz y el borrado de la cuenta.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude, cerebro principal (opcional, el único proveedor pago) ---
# Clave de la API de Anthropic (platform.claude.com/settings/keys). Solo servidor.
# Sin ella el Agente usa los proveedores gratuitos de abajo. El tope mensual y el
# modelo de cada uso se eligen en Configuración.
ANTHROPIC_API_KEY=

# --- Cerebro gratuito (hace falta al menos Gemini o Groq si no hay Claude) ---
GEMINI_API_KEY=
# Opcionales: si quedan vacíos se usan gemini-3.6-flash y gemini-3.5-flash-lite.
GEMINI_MODEL_CHAT=
GEMINI_MODEL_FONDO=
GROQ_API_KEY=
# Opcional: si queda vacío se usa openai/gpt-oss-120b.
GROQ_MODEL=

# --- Modelo local con Ollama (opcional) ---
# Dirección pública del túnel (https), nunca localhost: el servidor corre en Vercel.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Token que exige el proxy que protege el túnel.
OLLAMA_AUTH_TOKEN=
# Opcional: milisegundos que se espera a que conteste antes de pasar al siguiente (6000).
OLLAMA_TIMEOUT_MS=

# --- Voz con Azure Speech (opcional: sin esto se usa la voz del navegador) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Opcionales: cupo mensual gratuito, por si Azure lo cambia (18000 s y 500000 caracteres).
AZURE_CUPO_STT_SEGUNDOS=
AZURE_CUPO_TTS_CARACTERES=

# --- Notificaciones push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un contacto para el servicio de push: mailto:tu-correo o la URL de la app.
VAPID_SUBJECT=

# --- Programador de llamadas ---
# El mismo valor se carga en Supabase (Vault), ver CREDENCIALES.md.
CRON_SECRET=

# --- Solo para pruebas automáticas (no cargar en Vercel) ---
# GEMINI_BASE_URL, GROQ_BASE_URL, ANTHROPIC_BASE_URL y AZURE_SPEECH_TOKEN_URL apuntan los
# adaptadores a los servidores de mentira de tests/recorrida.
